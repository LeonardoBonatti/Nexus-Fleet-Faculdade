{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "frontend",
  "functions": {
    "api/**": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "frontend/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api?__path=/api/$1" }
  ],
  "crons": [
    { "path": "/api/cron", "schedule": "0 9 * * *" }
  ]
}
