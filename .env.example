# Copie este arquivo para ".env" (uso local) ou cadastre as variáveis em
# Vercel → Settings → Environment Variables. NUNCA suba o .env para o GitHub.

# ==========================================================================
# Banco de dados — PostgreSQL (Neon / Vercel Postgres)  [OBRIGATÓRIO]
# ==========================================================================
# Ao criar o banco em Vercel → Storage → Neon, esta variável é preenchida
# automaticamente no projeto. Para rodar localmente, copie a "Connection string"
# do painel do Neon (a versão "pooled" é a recomendada).
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/nexusfleet?sslmode=require

# Número máximo de conexões por instância (serverless: manter baixo)
PG_POOL_MAX=3

# ==========================================================================
# Autenticação
# ==========================================================================
# Use uma chave longa e aleatória — NUNCA publique a chave real
JWT_SECRET=troque_por_uma_chave_longa_e_aleatoria
JWT_EXPIRATION=24h

# ==========================================================================
# Segurança
# ==========================================================================
# RNF03 — chave de criptografia de CPF/CNH: 64 caracteres hexadecimais (32 bytes).
# Se não for definida, é derivada do JWT_SECRET (aceitável apenas em desenvolvimento).
# ATENÇÃO: trocar a chave depois de cadastrar motoristas torna os dados ilegíveis.
DATA_ENCRYPTION_KEY=

# RNF03 — em produção, requisições HTTP são redirecionadas para HTTPS (false desativa)
FORCE_HTTPS=true

# RNF05 — meses de retenção do log de auditoria (mínimo 12)
AUDIT_RETENTION_MONTHS=24

# ==========================================================================
# Rotina automática (Vercel Cron → GET /api/cron)
# ==========================================================================
# Segredo enviado pela Vercel no cabeçalho Authorization das execuções agendadas.
# Gere um valor aleatório qualquer.
CRON_SECRET=troque_por_outro_valor_aleatorio

# ==========================================================================
# Dados de demonstração
# ==========================================================================
# Cria a empresa demo com os 4 perfis (senha Senha@123) na primeira execução.
# A carga é idempotente: se a empresa já existir, nada é recriado.
# Depois da apresentação, troque para false.
SEED_DEMO=true

# ==========================================================================
# Execução local (ignorado na Vercel)
# ==========================================================================
PORT=3000
NODE_ENV=development
